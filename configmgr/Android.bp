cc_library_shared {
    name: "libaudiohalcm",
    defaults: ["libaudiohalcm_cc_defaults"],
    proprietary: true,
	vendor: true,
    cflags: [
		"-DETC_PATH=\"/vendor/etc/\""
        "-Werror",
        "-Wno-error=unused-parameter",
        "-Wno-unused-parameter",
    ],
    shared_libs: [
        "libcutils",
        "libutils",
        "libdl",
        "liblog",
        "libhardware",
        "libtinyalsav2",
        "libexpat"
    ],
    header_libs: [
        "libtinyalsav2_headers",
        "tinyhal_headers",
    ],
    srcs: ["audio_config.c"],
}

soong_config_module_type {
    name: "libaudiohalcm_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "tinyhal",
    bool_variables: [
        "tinyalsa_no_add_new_ctrls",
        "tinyalsa_no_ctl_get_id",
    ],
    properties: [
        "cppflags",
    ],
}

tinyhal_cc_defaults {
    name: "libaudiohalcm-defaults",
    soong_config_variables: {
        tinyalsa_no_add_new_ctrls: {
            cppflags: ["-DTINYALSA_NO_ADD_NEW_CTRLS"],
        },
        tinyalsa_no_ctl_get_id: {
            cppflags: ["-DTINYALSA_NO_CTL_GET_ID"],
        },
    },
}
