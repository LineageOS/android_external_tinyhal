cc_library_shared {
    name: "libaudiohalcm",
    proprietary: true,
    vendor: true,
    cflags: [
        "-DETC_PATH=\"/vendor/etc/\"",
        "-Werror",
        "-Wno-error=unused-parameter",
        "-Wno-unused-parameter",
    ] + select(soong_config_variable("tinyhal", "libaudiohalcm_continue_on_ctl_open_error"), {
        true: ["-DLIBAUDIOHALCM_CONTINUE_ON_CTL_OPEN_ERROR"],
        default: [],
    }) + select(soong_config_variable("tinyhal", "tinyalsa_no_add_new_ctrls"), {
        true: ["-DTINYALSA_NO_ADD_NEW_CTRLS"],
        default: [],
    }) + select(soong_config_variable("tinyhal", "tinyalsa_no_ctl_get_id"), {
        true: ["-DTINYALSA_NO_CTL_GET_ID"],
        default: [],
    }),
    shared_libs: [
        "libcutils",
        "libdl",
        "libexpat",
        "libhardware",
        "liblog",
        "libtinyalsav2",
        "libutils",
    ],
    header_libs: [
        "libtinyalsav2_headers",
        "tinyhal_headers",
    ],
    srcs: ["audio_config.c"],
}
