cc_library_shared {
    name: "audio.primary.tinyhal",
    defaults: ["audio.primary.tinyhal-defaults"],
    relative_install_path: "hw",
    proprietary: true,
    vendor: true,
    cflags: [
        "-DETC_PATH=\"/vendor/etc/\""
        "-Werror",
        "-Wno-error=unused-parameter",
        "-Wno-unused-parameter",
    ],
    shared_libs: [
        "libcutils",
        "libutils",
        "libdl",
        "liblog",
        "libhardware",
        "libtinyalsav2",
        "libtinycompress",
        "libaudiohalcm",
        "libaudioutils",
        "libsysutils",
        "libexpat"
    ],
    header_libs: [
        "libtinyalsav2_headers",
        "tinyhal_headers",
    ],
    static_libs: [
        "libmedia_helper",
    ],
    srcs: ["audio_hw.c"],
}

soong_config_module_type {
    name: "tinyhal_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "tinyhal",
    bool_variables: [
        "voice_recof_req_sthal",
        "tinycmopress_tstamp_long",
        "tinyhal_compress_playback",
    ],
    properties: [
        "cppflags",
        "shared_libs",
    ],
}

tinyhal_cc_defaults {
    name: "audio.primary.tinyhal-defaults",
    soong_config_variables: {
        voice_recof_req_sthal: {
            cppflags: ["-DENABLE_STHAL_STREAMS"],
            shared_libs: ["libscc_audio"]
        },
        tinycmopress_tstamp_long: {
            cppflags: ["-DTINYCOMPRESS_TSTAMP_IS_LONG"],
        },
        tinyhal_compress_playback: {
            cppflags: ["-DTINYHAL_COMPRESS_PLAYBACK"],
        },
    },
}
