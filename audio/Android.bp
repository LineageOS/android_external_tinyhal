cc_library_shared {
    name: "audio.primary.tinyhal",
    relative_install_path: "hw",
    proprietary: true,
    vendor: true,
    cflags: [
        "-DETC_PATH=\"/vendor/etc/\"",
        "-Werror",
        "-Wno-error=unused-parameter",
        "-Wno-unused-parameter",
    ] + select(soong_config_variable("tinyhal", "tinycompress_tstamp_long"), {
        true: ["-DTINYCOMPRESS_TSTAMP_IS_LONG"],
        default: [],
    }) + select(soong_config_variable("tinyhal", "tinyhal_compress_playback"), {
        true: ["-DTINYHAL_COMPRESS_PLAYBACK"],
        default: [],
    }) + select(soong_config_variable("tinyhal", "voice_recof_req_sthal"), {
        true: ["-DENABLE_STHAL_STREAMS"],
        default: [],
    }) + select(soong_config_variable("tinyhal", "out_rate_default"), {
        any @ flag_val: ["-DOUT_RATE_DEFAULT=\"" + flag_val + "\""],
        default: [],
    }) + select(soong_config_variable("tinyhal", "in_rate_default"), {
        any @ flag_val: ["-DIN_RATE_DEFAULT=\"" + flag_val + "\""],
        default: [],
    }),
    shared_libs: [
        "libaudiohalcm",
        "libaudioutils",
        "libcutils",
        "libdl",
        "libexpat",
        "libhardware",
        "liblog",
        "libsysutils",
        "libtinyalsav2",
        "libtinycompress",
        "libutils",
    ] + select(soong_config_variable("tinyhal", "voice_recof_req_sthal"), {
        true: ["libscc_audio"],
        default: [],
    }),
    header_libs: [
        "libtinyalsav2_headers",
        "tinyhal_headers",
    ],
    static_libs: [
        "libmedia_helper",
    ],
    srcs: ["audio_hw.c"],
}
